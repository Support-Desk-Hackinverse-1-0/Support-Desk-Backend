# Server Configuration
PORT=3000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/supportDesk
PINECONE_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=support-desk

# JWT Authentication
JWT_SECRET=your_jwt_secret_here

# Cloud Storage (ImageKit)
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key_here
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# Mistral AI
MISTRALAI_KEY=your_mistral_api_key_here
